---
import { useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale as 'en' | 'de';
const t = useTranslations(lang);

const base = `/${lang}`;
---
<footer>
  <div class="container footer-container">
    <div class="footer-brand">
      <img src="/lrgenius.png" alt={t('alt.logo')} width="30" height="30">
      <span>LrGenius</span>
    </div>
    <div class="footer-links">
      <a href="/compare">Compare AI plugins for Lightroom</a>
      <a href="/lrgenius-vs-excire">LrGenius vs. Excire &amp; others</a>
      <a href="/help">Help &amp; Docs</a>
      <a href="/about">About</a>
    </div>
    <div class="footer-social">
      <a href="https://ko-fi.com/W7X2240HF4" target="_blank" rel="noopener">
        <img src="https://ko-fi.com/img/githubbutton_sm.svg" alt="Support LrGenius on Ko-fi" height="32">
      </a>
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: #f8f9fa;
    border-top: 1px solid #eaeaea;
    padding: 2rem 0;
    margin-top: 4rem;
    font-size: 0.9rem;
    color: #6c757d;
  }

 .footer-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
  }

 .footer-brand {
    display: flex;
    align-items: center;
    font-weight: bold;
  }

 .footer-brand img {
    margin-right: 8px;
  }

 .footer-links a,.footer-social a {
    color: #6c757d;
    margin: 0 10px;
  }
  
 .footer-social img {
    display: block;
    height: 32px;
    width: auto;
  }

 .footer-links a:hover,.footer-social a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
   .footer-container {
      flex-direction: column;
      text-align: center;
    }
   .footer-brand,.footer-links,.footer-social {
      margin-bottom: 1rem;
    }
  }
</style>