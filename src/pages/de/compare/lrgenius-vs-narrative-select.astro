    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    vertical-align: middle;
    margin-left: 0.3rem;
    text-transform: uppercase;
  }
  h3 {
    margin-top: 1.5rem;
  }
  .related-comparisons ul {
    list-style: none;
