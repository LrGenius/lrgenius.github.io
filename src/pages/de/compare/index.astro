---
import Layout from '../../../layouts/Layout.astro';

const title = 'Die besten KI-Plugins für Adobe Lightroom Classic (2026)';
const description = 'Vergleiche LrGenius, Excire Search, Peakto, Aftershoot, Narrative Select, Imagen AI und Neurapix — ein ehrlicher Feature-Vergleich der KI-Tools für Lightroom-Classic-Fotografen, inklusive lokaler Artenerkennung.';
const lastUpdated = '2026-08-17';
---

<Layout title={`${title} — LrGenius`} description={description} translatedPath="/compare">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "datePublished": lastUpdated,
    "dateModified": lastUpdated,
    "author": { "@type": "Organization", "name": "LrGenius", "url": "https://lrgenius.com" },
    "about": [
      { "@type": "SoftwareApplication", "name": "LrGeniusAI" },
      { "@type": "Thing", "name": "Excire Search" },
      { "@type": "Thing", "name": "Peakto" },
      { "@type": "Thing", "name": "Aftershoot" },
      { "@type": "Thing", "name": "Narrative Select" },
      { "@type": "Thing", "name": "Imagen AI" },
      { "@type": "Thing", "name": "Neurapix" }
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://lrgenius.com/de" },
      { "@type": "ListItem", "position": 2, "name": "KI-Plugins für Lightroom im Vergleich", "item": "https://lrgenius.com/de/compare" }
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Was ist das beste kostenlose KI-Plugin für Adobe Lightroom Classic?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "LrGeniusAI ist das einzige völlig kostenlose und quelloffene (AGPL-3.0) KI-Plugin für Lightroom Classic. Es deckt KI-Verschlagwortung, Bildunterschriften, semantische Suche, Culling, Gesichtserkennung und lokale Artenerkennung ab — ganz ohne Abo. Es kann zu 100 % lokal laufen, mit KI-Modellen, die direkt im Plugin eingebaut sind, oder über Ollama und LM Studio, sodass deine Fotos deinen Rechner nie verlassen."
        }
      },
      {
        "@type": "Question",
        "name": "Welches KI-Plugin für Lightroom funktioniert offline ohne Internet?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "LrGeniusAI, Excire Search, Aftershoot und Peakto bieten alle lokale bzw. Offline-Verarbeitung. LrGeniusAI führt Vision-Modelle direkt in seinem eigenen Backend aus — MLX auf Apple-Silicon-Macs und llama.cpp unter Windows —, sodass keine separate KI-Anwendung nötig ist, und kann zusätzlich einen vorhandenen Ollama- oder LM-Studio-Server nutzen. Semantische Suche, Gesichtserkennung und Artenerkennung laufen unabhängig vom gewählten Anbieter immer lokal auf dem Gerät. Es ist das einzige dieser Tools, das kostenlos und quelloffen ist."
        }
      },
      {
        "@type": "Question",
        "name": "Welches Lightroom-Plugin kann Tier- und Pflanzenarten identifizieren?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "LrGeniusAI identifiziert Tiere, Pflanzen und Pilze mit BioCLIP 2, das vollständig auf deinem eigenen Rechner läuft. Es schreibt den wissenschaftlichen Namen, den gebräuchlichen Namen, die taxonomische Rangstufe, die Konfidenz und die vollständige linnésche Taxonomie in durchsuchbare Lightroom-Metadatenfelder und kann die Taxonomie optional zusätzlich als Schlagwort-Hierarchie unter einer Species-Wurzel anlegen. Ist sich das Modell bei der Art nicht sicher, gibt es die tiefste Rangstufe an, die es sicher bestimmen kann — etwa Ordnung oder Klasse —, statt einen binomialen Artnamen zu raten. Andere KI-Tools für Lightroom markieren nur generische Motive wie „Vogel“ oder „Blume“, statt eine taxonomische Bestimmung zu liefern."
        }
      },
      {
        "@type": "Question",
        "name": "Was ist das beste KI-Tool zur Culling für Lightroom Classic?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Für professionelles Culling großer Bildmengen (Hochzeiten, Events) sind Aftershoot und Narrative Select die ausgereiftesten, spezialisierten Tools. LrGeniusAI integriert KI-gestütztes Culling in ein breiter angelegtes, kostenloses Plugin — eine gute Wahl für Fotografen, die zusätzlich Verschlagwortung und Suche an einem Ort haben möchten, ohne ein weiteres Abo."
        }
      }
    ]
  })} />

  <section class="hero compact">
    <h1>Die besten KI-Plugins für Adobe Lightroom Classic (2026)</h1>
    <p class="tagline">Ein ehrlicher Vergleich von KI-Tools für Verschlagwortung, Culling, Suche und Bildbearbeitung.</p>
    <p class="meta">Zuletzt aktualisiert: {lastUpdated}</p>
  </section>

  <section class="intro">
    <p>
      <strong>LrGeniusAI</strong> ist das einzige <strong>kostenlose, quelloffene</strong> (AGPL-3.0) KI-Plugin für
      Lightroom Classic. Es läuft <strong>zu 100 % lokal</strong>, mit KI-Modellen, die direkt im Plugin eingebaut sind — deine Fotos
      verlassen deinen Rechner nie — oder verbindet sich mit Cloud-Modellen (ChatGPT, Gemini). Kein Abo, keine
      Nutzungsgrenzen durch das Plugin selbst. Es ist zudem das einzige Tool in diesem Vergleich, das
      <strong>taxonomische Artenerkennung lokal auf dem Gerät</strong> durchführt — mit BioCLIP 2.
    </p>
    <p>
      Nachfolgend findest du einen Feature-für-Feature-Vergleich der wichtigsten KI-Tools im Lightroom-Ökosystem.
      Die meisten kommerziellen Optionen sind ausgereift und gut unterstützt; LrGeniusAI ist jünger und befindet sich in der Beta-Phase,
      dafür aber einzigartig kostenlos und offen. Wir sind um Sachlichkeit und Fairness bemüht — solltest du etwas Veraltetes entdecken,
      <a href="/de/contact">sag uns Bescheid</a>.
    </p>
  </section>

  <section class="comparison">
    <h2>Feature-Vergleich auf einen Blick</h2>
